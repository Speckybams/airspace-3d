# Cesium ion — https://ion.cesium.com/tokens
VITE_CESIUM_ION_ACCESS_TOKEN=

# Ordnance Survey Data Hub — https://osdatahub.os.uk/
VITE_OS_API_KEY=

# Paste the key string only (not a URL). Placeholder text triggers "API KEY REQUIRED" on the map.
# https://carto.com/basemaps/apikey/
VITE_CARTO_BASEMAPS_KEY=

# Server only. Same Resend key as Volugraph. Never prefix with VITE_.
# Cloudflare Pages: set RESEND_API_KEY for Production and Preview.
RESEND_API_KEY=
